# APP_URL: URL pública onde a aplicação está hospedada (ex: https://agenda-ativa.vercel.app)
APP_URL="MY_APP_URL"

# MOTOR DADOS DRIVE v2.0 (Variáveis de Servidor — recomendadas para produção no Vercel)
# Quando definidas no servidor, clientes na página pública conectam automaticamente sem expor segredos no navegador.
GAS_WEBAPP_URL=""
DRIVE_API_SECRET=""

# MÓDULO ENGSEG 2FA (Opcional — força proteção 2FA no painel admin em qualquer dispositivo)
ENGSEG_REQUIRED="false"
ENGSEG_ADMIN_EMAIL=""

# Opcional para builds estáticos caso deseje embutir no frontend:
VITE_GAS_WEBAPP_URL=""
VITE_ENGSEG_REQUIRED="false"
